---
import { ProjectsCatalog } from "../projects/ProjectsCatalog";
import { SectionGlow } from "../ui/SectionGlow";
import Layout from "../../layouts/Layout.astro";
import type { Locale } from "../../i18n/config";
import {
  getAlternateLinks,
  getLocalizedPageMetadata,
  getSwitchLocalePath
} from "../../data/site";
import { getProjectsArchiveContent, getProjectsPagePath } from "../../data/projects";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const metadata = getLocalizedPageMetadata(locale, "projects");
const archiveContent = getProjectsArchiveContent(locale);
---

<Layout
  locale={locale}
  title={metadata.title}
  description={metadata.description}
  canonicalPath={getProjectsPagePath(locale)}
  alternateLinks={getAlternateLinks("projects")}
  switchLocaleHref={getSwitchLocalePath(locale, "projects")}
>
  <section class="relative overflow-hidden border-b border-border py-20 lg:py-28">
    <SectionGlow accent="chart-4" anchor="center" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary">
          {archiveContent.eyebrow}
        </p>
        <h1 class="mt-4 text-balance text-4xl font-bold text-foreground sm:text-5xl lg:text-6xl">
          {archiveContent.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
          {archiveContent.description}
        </p>
      </div>

      <ProjectsCatalog locale={locale} client:load />
    </div>
  </section>
</Layout>
