---
import "../styles/globals.css";
import { Footer } from "../components/layout/Footer";
import { Navigation } from "../components/layout/Navigation";
import { CursorHalo } from "../components/ui/CursorHalo";
import { ScrollProgressBar } from "../components/ui/ScrollProgressBar";
import type { Locale } from "../i18n/config";
import { getLocalizedPageMetadata, withBase, type AlternateLink } from "../data/site";

interface Props {
  alternateLinks?: AlternateLink[];
  canonicalPath?: string;
  description?: string;
  locale: Locale;
  switchLocaleHref: string;
  title?: string;
}

const {
  alternateLinks = [],
  canonicalPath = "/",
  description,
  locale,
  switchLocaleHref,
  title
} = Astro.props as Props;

const metadata = getLocalizedPageMetadata(locale, canonicalPath.includes("/proyectos") || canonicalPath.includes("/projects") ? "projects" : "home");
const pageTitle = title ?? metadata.title;
const pageDescription = description ?? metadata.description;
const canonicalUrl = Astro.site ? new URL(canonicalPath, Astro.site).toString() : canonicalPath;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href={withBase("/images/logos/logo_vf_mini.webp")} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={Astro.site ? new URL(link.href, Astro.site).toString() : link.href} />
    ))}
		<title>{pageTitle}</title>
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased">
		<CursorHalo client:load />
		<ScrollProgressBar client:load />
		<Navigation locale={locale} switchLocaleHref={switchLocaleHref} client:load />
		<main class="min-h-screen pt-16 lg:pt-20">
			<slot />
		</main>
		<Footer locale={locale} client:visible />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
	}
</style>
