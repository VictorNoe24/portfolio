---
import { AboutSection } from "../components/about/AboutSection";
import { HeroSection } from "../components/hero/HeroSection";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<HeroSection client:load />
	<AboutSection client:visible />

	{
		[
			["experiencia", "Experiencia"],
			["proyectos", "Proyectos"],
			["habilidades", "Habilidades"],
			["educacion", "Educacion"],
			["contacto", "Contacto"]
		].map(([id, title]) => (
			<section
				id={id}
				class="border-b border-border px-4 py-24 sm:px-6 lg:px-8"
			>
				<div class="mx-auto max-w-7xl">
					<p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary">{title}</p>
					<h2 class="mt-4 text-3xl font-bold text-foreground sm:text-4xl">{title}</h2>
					<p class="mt-4 max-w-2xl text-lg leading-8 text-muted-foreground">
						Seccion temporal para conectar la navegacion. Aqui vamos a montar el contenido real
						del portafolio.
					</p>
				</div>
			</section>
		))
	}
</Layout>
